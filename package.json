{
  "name": "formatavern",
  "private": true,
  "workspaces": ["backend", "frontend", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel dev:backend dev:frontend",
    "dev:lan": "bun scripts/dev-lan.ts",
    "dev:backend": "bun --watch backend/src/index.ts",
    "dev:frontend": "bun run --cwd frontend dev",
    "tunnel": "bun scripts/tunnel.ts",
    "stop": "bun scripts/stop.ts",
    "build": "bun run --cwd frontend build",
    "start": "NODE_ENV=production bun run --cwd backend start",
    "typecheck": "bun run --cwd packages/shared typecheck && bun run --cwd backend typecheck && bun run --cwd frontend check",
    "test": "bun run --cwd packages/shared test && bun run --cwd backend test && bun run --cwd frontend test",
    "db:migrate": "bun run --cwd backend db:migrate",
    "db:seed": "bun run --cwd backend db:seed",
    "db:check": "bun run --cwd backend db:check",
    "db:reset": "bun run --cwd backend db:reset",
    "db:reindex": "bun run --cwd backend db:reindex",
    "clean": "rm -rf node_modules frontend/.svelte-kit frontend/build"
  },
  "devDependencies": {
    "typescript": "^5.5"
  }
}
